# ==============================================================================
# BELOKIRI (belokiri.id) - ENVIRONMENT CONFIGURATION TEMPLATE
# Salin file ini menjadi .env atau .env.local dan sesuaikan nilainya.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL / Supabase / Neon)
# ------------------------------------------------------------------------------
# DATABASE_URL: Gunakan connection pooler (port 6543 untuk Supabase dengan pgbouncer=true).
# DIRECT_URL: Gunakan koneksi langsung (port 5432) khusus untuk menjalankan prisma migrate / db push.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 2. SESSION & CRYPTOGRAPHIC SECURITY
# ------------------------------------------------------------------------------
# Kunci rahasia minimal 32 karakter untuk menandatangani cookie sesi (HMAC-SHA256).
# Jangan bagikan atau commit kunci ini ke repository publik!
# Contoh generate di terminal: openssl rand -base64 32
SESSION_SECRET="ganti-dengan-string-acak-minimal-32-karakter-untuk-produksi-belokiri"

# ------------------------------------------------------------------------------
# 3. CANONICAL APP URL & DOMAIN
# ------------------------------------------------------------------------------
# URL utama aplikasi untuk sitemap, metadata OpenGraph, canonical links, dan OAuth callback.
NEXT_PUBLIC_APP_URL="https://belokiri.id"

# ------------------------------------------------------------------------------
# 4. MEDIA ASSET STORAGE (Cloudinary)
# ------------------------------------------------------------------------------
# Dapatkan kredensial gratis di https://cloudinary.com/
# Jika kosong, sistem otomatis menggunakan local upload fallback ke /public/uploads/
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_PRESET="belokiri_preset"

# ------------------------------------------------------------------------------
# 5. GOOGLE OAUTH 2.0 AUTHENTICATION
# ------------------------------------------------------------------------------
# Buat kredensial di https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://belokiri.id/api/auth/callback/google
# Jika kosong, sistem otomatis menyediakan tombol One-Click Demo Login untuk pengujian.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ------------------------------------------------------------------------------
# 6. OPTIONAL DISTRIBUTED RATE LIMITING (Upstash Redis)
# ------------------------------------------------------------------------------
# Jika kosong, sistem secara default menggunakan In-Memory Sliding Window Rate Limiter.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
